# URL publique du site (sans slash final) — utilisée pour les canonical, le sitemap et le JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.dome-electricite.fr

# Formulaire de contact (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Domé Électricité
CONTACT_RECIPIENT_EMAIL=

# WordPress headless (facultatif) — ex. https://cms.dome-electricite.fr/wp-json
WP_API_URL=
# Secret partagé avec le webhook WordPress -> POST /api/revalidate
REVALIDATE_SECRET=
